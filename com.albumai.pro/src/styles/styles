:root {

    --bg: #111315;
    --panel: #1b1d20;
    --panel-light: #24272b;
    --border: #34383e;

    --primary: #4ea3ff;
    --primary-hover: #6ab4ff;

    --text: #f3f3f3;
    --text-secondary: #b0b6bf;

    --success: #38c172;
    --warning: #ffb020;
    --danger: #ff5c5c;

    --radius: 12px;

    --transition: 0.2s ease;

    --sidebar-width: 320px;
    --preview-width: 420px;

    font-family:
        Inter,
        "Segoe UI",
        Arial,
        sans-serif;

}

* {

    margin: 0;
    padding: 0;
    box-sizing: border-box;

}

html,
body,
#root {

    width: 100%;
    height: 100%;

    background: var(--bg);

    color: var(--text);

    overflow: hidden;

}

button,
input,
select {

    font: inherit;

}

button {

    cursor: pointer;

    border: none;

    border-radius: 8px;

    transition: var(--transition);

}

.albumai-app {

    width: 100%;
    height: 100vh;

    display: flex;

    flex-direction: column;

    background: var(--bg);

}

.albumai-header {

    height: 64px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 24px;

    background: var(--panel);

    border-bottom: 1px solid var(--border);

}

.albumai-header h1 {

    font-size: 22px;

    font-weight: 700;

}

.albumai-main {

    flex: 1;

    display: grid;

    grid-template-columns:

        var(--sidebar-width)

        1fr

        var(--preview-width);

    overflow: hidden;

}

.albumai-sidebar {

    background: var(--panel);

    border-right: 1px solid var(--border);

    overflow-y: auto;

}

.albumai-content {

    background: #15171a;

    overflow: auto;

    padding: 18px;

}

.albumai-preview {

    background: var(--panel);

    border-left: 1px solid var(--border);

    overflow-y: auto;

}

.albumai-footer {

    height: 38px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 20px;

    background: var(--panel);

    border-top: 1px solid var(--border);

    color: var(--text-secondary);

    font-size: 13px;

}

.albumai-loading {

    width: 100%;
    height: 100vh;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 24px;

    font-weight: 600;

}

.panel {

    background: var(--panel-light);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    padding: 18px;

    margin-bottom: 18px;

}

.panel-title {

    font-size: 17px;

    margin-bottom: 16px;

}

.button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    padding: 10px 18px;

    background: var(--primary);

    color: white;

}

.button:hover {

    background: var(--primary-hover);

}

.button.secondary {

    background: #2f3338;

}

.button.success {

    background: var(--success);

}

.button.warning {

    background: var(--warning);

    color: black;

}

.button.danger {

    background: var(--danger);

}

.input {

    width: 100%;

    padding: 10px 12px;

    margin-bottom: 12px;

    background: #202326;

    border: 1px solid var(--border);

    color: white;

    border-radius: 8px;

}

.thumbnail-grid {

    display: grid;

    grid-template-columns:

        repeat(auto-fill, minmax(160px, 1fr));

    gap: 16px;

}

.thumbnail-card {

    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 10px;

    overflow: hidden;

    transition: var(--transition);

}

.thumbnail-card:hover {

    transform: translateY(-2px);

    border-color: var(--primary);

}

.thumbnail-card img {

    width: 100%;

    display: block;

}

.thumbnail-info {

    padding: 10px;

    font-size: 12px;

    color: var(--text-secondary);

}

.preview-panel {

    padding: 18px;

}

.preview-image {

    width: 100%;

    border-radius: var(--radius);

    border: 1px solid var(--border);

}

.scrollbar::-webkit-scrollbar {

    width: 10px;

}

.scrollbar::-webkit-scrollbar-thumb {

    background: #555;

    border-radius: 100px;

}

.scrollbar::-webkit-scrollbar-track {

    background: transparent;

}

.hidden {

    display: none !important;

}

.flex {

    display: flex;

}

.column {

    flex-direction: column;

}

.center {

    display: flex;

    align-items: center;

    justify-content: center;

}

.space-between {

    justify-content: space-between;

}

.gap-8 {

    gap: 8px;

}

.gap-16 {

    gap: 16px;

}

.w-100 {

    width: 100%;

}

.h-100 {

    height: 100%;

}

.text-center {

    text-align: center;

}

@media (max-width: 1400px) {

    .albumai-main {

        grid-template-columns:

            280px

            1fr

            340px;

    }

}

@media (max-width: 1100px) {

    .albumai-main {

        grid-template-columns:

            260px

            1fr;

    }

    .albumai-preview {

        display: none;

    }

}